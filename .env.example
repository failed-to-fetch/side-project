# DB setup
POSTGRES_USER=app
POSTGRES_PASSWORD=replace_with_a_strong_password
POSTGRES_DB=appdb

# Copy this file to .env and fill in the values. Never commit .env.
# No quotes and no spaces around "=".

# Encrypts GitHub tokens stored in the database. Generate with:
#   docker compose run --rm backend python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep a backup: losing it means users have to re-link GitHub.
TOKEN_ENCRYPTION_KEY=

# From your GitHub App settings page (see "Set up a GitHub App" in README.md).
# Client ID starts with "Iv". The client secret is shown only once when generated.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Run scripts/setup.sh to create .env from this file and generate the secrets.
# Or copy it to .env by hand. Never commit .env.
# No quotes and no spaces around "=".

# ---------------------------------------------------------------- Postgres
POSTGRES_USER=app
POSTGRES_DB=appdb
# Generated by setup.sh. Postgres only reads this when its volume is first
# created; changing it later needs scripts/reset-db.sh or ALTER USER (see README).
POSTGRES_PASSWORD=

# ---------------------------------------------------------------- Secrets (generated by setup.sh)
# Encrypts provider tokens stored in the database. Back it up: if it's lost,
# stored tokens can't be decrypted and users must re-link GitHub.
TOKEN_ENCRYPTION_KEY=
# Signs Better Auth sessions (at least 32 characters). Changing it signs everyone out.
BETTER_AUTH_SECRET=

# ---------------------------------------------------------------- Sign-in (auth service)
# Required. A GitHub *OAuth App* for "Sign in with GitHub":
#   https://github.com/settings/applications/new
#   Callback URL: http://localhost:3001/api/auth/callback/github
GITHUB_LOGIN_CLIENT_ID=
GITHUB_LOGIN_CLIENT_SECRET=

# Optional. Leave empty to hide these sign-in options.
GITLAB_LOGIN_CLIENT_ID=
GITLAB_LOGIN_CLIENT_SECRET=
BITBUCKET_LOGIN_CLIENT_ID=
BITBUCKET_LOGIN_CLIENT_SECRET=

# ---------------------------------------------------------------- Repo access (backend)
# Optional. A GitHub *App* (not the OAuth App above) for linking repositories.
# See "Set up a GitHub App" in README.md. The client ID starts with "Iv".
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ---------------------------------------------------------------- Outside Docker only
# Docker Compose sets these itself. They're only read when running a service
# on your machine, e.g. `pnpm auth:migrate` in services/auth.
# DATABASE_URL=postgresql://app:<POSTGRES_PASSWORD>@localhost:5432/appdb
# BETTER_AUTH_URL=http://localhost:3001
